---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site.js";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: `${site.url}/`,
      name: "Drone Craft",
      description:
        "Mallacoota aerial photography, drone video and interactive 360 panoramas by Colin Dixon",
      inLanguage: "en-AU",
      publisher: { "@id": `${site.url}/#person` },
    },
    {
      "@type": "Person",
      "@id": `${site.url}/#person`,
      name: "Colin Dixon",
      url: `${site.url}/`,
      email: `mailto:${site.email}`,
      telephone: "+61419415000",
      jobTitle: "Aerial artist and digital strategist",
      homeLocation: { "@type": "Place", name: "Mallacoota, Victoria, Australia" },
    },
    {
      "@type": "Service",
      name: "Drone photography, aerial video and 360 panoramas",
      description:
        "Aerial imagery, coastal drone video, interactive 360 panoramas and digital storytelling",
      provider: { "@id": `${site.url}/#person` },
      areaServed: { "@type": "Place", name: "Mallacoota, Victoria, Australia" },
      url: `${site.url}/#services`,
    },
  ],
};
---

<Layout
  title="Drone Craft | Mallacoota Aerial Art by Colin Dixon"
  description="Explore Mallacoota aerial photography, cinematic drone video and interactive 360 panoramas by Colin Dixon. Aerial art and digital media from Victoria's far east coast."
  canonical={`${site.url}/`}
  ogTitle="Drone Craft | Mallacoota Aerial Art"
  ogDescription="Cinematic drone photography, video, 360 panoramas, and digital storytelling from Mallacoota, Victoria."
  ogUrl={`${site.url}/`}
  jsonLd={jsonLd}
  currentPath="/"
  keywords="Drone Craft, Colin Dixon, Mallacoota, DJI Mavic 4 Pro, drone photography, aerial art, 360 panoramas, Victoria"
>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-media" aria-hidden="true">
            <picture>
              <source srcset="/images/betka-clouds.webp" type="image/webp" />
              <img src="/images/betka-clouds.jpg" alt="" fetchpriority="high" />
            </picture>
          </div>
          <div class="aurora"></div>
          <div class="ice-field" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="hero-drone-wrap" role="img" aria-label="Flying DJI Mavic 4 Pro style drone">
            <img class="hero-drone" src="/images/mavic-4-pro-cutout.png" alt="" />
            <span class="camera-logo" aria-hidden="true">Hasselblad</span>
            <span class="nav-light nav-light-red" aria-hidden="true"></span>
            <span class="nav-light nav-light-green" aria-hidden="true"></span>
          </div>

          <div class="hero-content is-visible">
            <p class="eyebrow">Mallacoota aerial art / AI media / 360 worlds</p>
            <h1 id="hero-title">Drone Craft</h1>
            <p class="hero-copy">
              Cinematic coastal flight, digital strategy, and immersive visual stories by
              Colin Dixon.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href="https://coota.au/" target="_blank" rel="noopener">
                <i class="fa-solid fa-camera-retro" aria-hidden="true"></i>
                View Aerial Work
              </a>
              <a
                class="button button-secondary"
                href={site.calendly}
                target="_blank"
                rel="noopener"
              >
                <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                Schedule a Chat
              </a>
            </div>
          </div>

          <div class="hero-panel ice-glass is-visible" aria-label="Drone Craft highlights">
            <div>
              <span>Platform</span>
              <strong>DJI Mavic 4 Pro</strong>
            </div>
            <div>
              <span>Base</span>
              <strong>Mallacoota, VIC</strong>
            </div>
            <div>
              <span>Media</span>
              <strong>Drone / 360 / Video</strong>
            </div>
          </div>
        </section>

        <section class="intro section-band">
          <div class="intro-copy reveal">
            <p class="eyebrow">Field work meets digital craft</p>
            <h2>Built for the coast, the sky, and the screen.</h2>
            <p>
              Drone Craft brings Mallacoota's beaches, lakes, cloud forms, and wilderness
              edges into aerial photography, cinematic drone video and interactive 360 panoramas. The work combines on-location flying with careful editing and digital storytelling.
            </p>
          </div>
          <div class="portrait-strip reveal">
            <picture class="ice-frame portrait-frame">
              <source srcset="/images/Colin-Pebbly1-2k.webp" type="image/webp" />
              <img src="/images/Colin-Pebbly1-2k.png" alt="Colin Dixon at Pebbly Beach" />
            </picture>
            <div>
              <span>Colin Dixon</span>
              <strong>Aerial artist and digital strategist</strong>
            </div>
          </div>
        </section>

        <section class="section-band services-section" id="services" aria-labelledby="services-title">
          <div class="section-heading">
            <p class="eyebrow">What I create</p>
            <h2 id="services-title">Aerial images, film and immersive views</h2>
          </div>
          <div class="services-grid">
            <article><h3>Aerial photography</h3><p>Coastal landscapes, beaches, lakes and changing light captured from above, for digital presentation and fine art imagery.</p></article>
            <article><h3>Drone video</h3><p>Cinematic footage of Mallacoota and its surroundings, edited into visual stories for the screen.</p></article>
            <article><h3>Interactive 360 panoramas</h3><p>Immersive scenes that let viewers explore a location and look around for themselves.</p></article>
          </div>
          <p>Based in Mallacoota, Victoria. To discuss a project, <a href={`mailto:${site.email}`}>email Colin</a> or <a href={site.calendly} target="_blank" rel="noopener">schedule a chat</a>.</p>
        </section>

        <section class="work-grid section-band" id="work" aria-labelledby="work-title">
          <div class="section-heading reveal">
            <p class="eyebrow">Featured scenes</p>
            <h2 id="work-title">Mallacoota from above</h2>
          </div>
          <article class="scene-card ice-frame reveal">
            <picture>
              <source srcset="/images/sunrise-coota.webp" type="image/webp" />
              <img src="/images/sunrise-coota.jpg" alt="Mallacoota sunrise aerial panorama" />
            </picture>
            <div>
              <span>Sunrise Coota</span>
              <p>Wide coastal light with room for print, web, and video treatments.</p>
            </div>
          </article>
          <article class="scene-card ice-frame reveal">
            <picture>
              <source srcset="/images/betka-clouds.webp" type="image/webp" />
              <img src="/images/betka-clouds.jpg" alt="Betka clouds and coastline aerial view" />
            </picture>
            <div>
              <span>Betka Clouds</span>
              <p>High-drama cloud layers, coastline geometry, and wilderness scale.</p>
            </div>
          </article>
        </section>

        <section class="video-section section-band" id="video" aria-labelledby="video-title">
          <div class="section-heading reveal">
            <p class="eyebrow">Cinematic reel</p>
            <h2 id="video-title">Mallacoota in motion</h2>
          </div>
          <div class="media-frame ice-frame reveal">
            <iframe
              data-video-id="hMtv0z8pSFc"
              title="Cinematic drone video of Mallacoota"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <p class="video-films-link reveal">
            Take these films home on a USB stick or DVD.
            <a href="/films">Browse the films and formats</a>.
          </p>
        </section>

        <section class="panorama-section section-band" id="panorama" aria-labelledby="panorama-title">
          <div class="section-heading reveal">
            <p class="eyebrow">Immersive 360</p>
            <h2 id="panorama-title">Step inside the landscape</h2>
          </div>
          <div class="media-frame ice-frame reveal">
            <iframe
              allow="xr-spatial-tracking; gyroscope; accelerometer"
              allowfullscreen
              scrolling="no"
              data-kuula-src="https://kuula.co/share/hnh4w?logo=1&amp;info=1&amp;fs=1&amp;vr=1&amp;zoom=1&amp;sd=1&amp;autorotate=0.51&amp;thumbs=1"
              title="Interactive 360-degree panorama of Mallacoota"
              loading="lazy"
            ></iframe>
          </div>
        </section>

        <section class="section-band" aria-label="Sponsored">
          <div class="ad-row-wrap">
            <div class="ad-row">
              <div class="ad-slot ad-300x250" data-ad-zone="in-content"></div>
              <div class="ad-slot ad-300x250 ad-col-2" data-ad-zone="in-content-2"></div>
              <div class="ad-slot ad-300x250 ad-col-3" data-ad-zone="in-content-3"></div>
            </div>
          </div>
        </section>

        <section class="connect section-band" id="connect" aria-labelledby="connect-title">
          <div class="section-heading reveal">
            <p class="eyebrow">Connect</p>
            <h2 id="connect-title">Follow the next flight</h2>
          </div>
          <div class="link-grid reveal" aria-label="Drone Craft links">
            <a href="https://www.facebook.com/groups/dronecraft" target="_blank" rel="noopener">
              <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
              <span>Facebook Group</span>
            </a>
            <a href={site.youtube} target="_blank" rel="noopener">
              <i class="fa-brands fa-youtube" aria-hidden="true"></i>
              <span>YouTube</span>
            </a>
            <a href="https://kuula.co/profile/mallacoota" target="_blank" rel="noopener">
              <i class="fa-solid fa-vr-cardboard" aria-hidden="true"></i>
              <span>360 Panoramas</span>
            </a>
            <a href="https://www.instagram.com/coldix/" target="_blank" rel="noopener">
              <i class="fa-brands fa-instagram" aria-hidden="true"></i>
              <span>Instagram</span>
            </a>
            <a href="https://x.com/colindixon" target="_blank" rel="noopener">
              <i class="fa-brands fa-x-twitter" aria-hidden="true"></i>
              <span>X</span>
            </a>
            <a href="https://oze.unleashed.substack.com/" target="_blank" rel="noopener">
              <i class="fa-solid fa-newspaper" aria-hidden="true"></i>
              <span>Substack</span>
            </a>
            <a href="https://discord.gg/NvmM3ny2TV" target="_blank" rel="noopener">
              <i class="fa-brands fa-discord" aria-hidden="true"></i>
              <span>Discord</span>
            </a>
            <a href={`mailto:${site.email}`}>
              <i class="fa-solid fa-envelope" aria-hidden="true"></i>
              <span>Email Colin</span>
            </a>
          </div>
        </section>
</Layout>
